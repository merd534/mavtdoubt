; Neon Noir: Shadows of Rain — Godot 4.6
; Конфигурация проекта. Порядок автозагрузок критичен:
; Log -> GameConfig -> CityAtlas -> WorldClock -> Citizens -> Api -> CrimeDirector

config_version=5

[application]

config/name="Neon Noir: Shadows of Rain"
config/description="Процедурный нуарно-неоновый детектив. Город и преступления генерируются на лету."
run/main_scene="res://scenes/dev/Phase2CityBench.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="NeonNoirShadowsOfRain"

[autoload]

Log="*res://scripts/core/Logger.gd"
GameConfig="*res://scripts/core/GameConfig.gd"
CityAtlas="*res://scripts/world/CityAtlas.gd"
CityMaterials="*res://scripts/city/CityMaterials.gd"
WorldClock="*res://scripts/world/WorldClock.gd"
Citizens="*res://scripts/world/CitizenRegistry.gd"
Api="*res://scripts/api/ApiConnector.gd"
CrimeDirector="*res://scripts/crime/CrimeDirector.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.039215688, 0.047058824, 0.07058824, 1)
occlusion_culling/use_occlusion_culling=true
occlusion_culling/occlusion_rays_per_thread=512
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
global_illumination/gi/use_half_resolution=false
